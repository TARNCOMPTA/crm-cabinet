# =============================================================================
#  CRM Cabinet — MODÈLE de configuration
#
#  ⚠️  CE FICHIER EST SUIVI PAR GIT ET LE DÉPÔT DEVIENDRA PUBLIC.
#      Il ne doit JAMAIS contenir de valeur réelle. Aucune exception.
#      Les vraies valeurs vont dans « .env », qui est ignoré par git.
#
#          cp .env.exemple .env      puis remplir .env
#
#  Sur un VPS, install.sh écrit ce fichier tout seul et génère les secrets :
#  ce modèle sert au développement et à la relecture.
# =============================================================================
#
#  ⚠️  DEUXIÈME RÈGLE : le préfixe VITE_ rend la variable PUBLIQUE.
#      Vite l'inscrit en clair dans le bundle JavaScript envoyé au navigateur.
#      → Un secret ne doit JAMAIS porter le préfixe VITE_.
#
#      Il n'y a plus aucune variable VITE_ dans ce projet, et c'est voulu : le
#      front ne lit plus rien de l'environnement de compilation. Ce dont il a
#      besoin, il le demande au serveur via /api/config, qui n'expose que des
#      valeurs publiques. Être tenté d'ajouter un VITE_ est le signe qu'une
#      valeur devrait passer par /api/config.
#
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Identité de l'instance
# -----------------------------------------------------------------------------

# Domaine servi par Caddy, et adresse pour le certificat Let's Encrypt.
DOMAIN=crm.moncabinet.fr
ACME_EMAIL=

# Adresse publique complète. Sert de base aux liens des courriers ET d'origine
# WebAuthn : elle doit correspondre exactement à ce que tape l'utilisateur.
PUBLIC_URL=https://crm.moncabinet.fr


# -----------------------------------------------------------------------------
#  2. Sessions — SECRET
# -----------------------------------------------------------------------------

# Signe les cookies de session ET les jetons transmis à PostgREST : les deux
# doivent partager le même secret, sinon PostgREST refuse tout.
#
# Générer :  openssl rand -hex 32
# Le changer déconnecte immédiatement tout le monde.
SESSION_SECRET=

# Durée d'une session, en secondes. 604800 = 7 jours.
SESSION_TTL=604800


# -----------------------------------------------------------------------------
#  3. Base de données — SECRET
# -----------------------------------------------------------------------------

POSTGRES_DB=crmcabinet
POSTGRES_USER=crm
# Générer :  openssl rand -hex 24
POSTGRES_PASSWORD=

# En Docker, docker-compose construit DATABASE_URL à partir des trois variables
# ci-dessus. Hors Docker (développement), renseignez-la directement :
# DATABASE_URL=postgres://crm:motdepasse@localhost:5432/crmcabinet

# PostgREST, joint en interne. Jamais exposé au réseau.
# POSTGREST_URL=http://localhost:3001


# -----------------------------------------------------------------------------
#  4. Passkeys (WebAuthn)
# -----------------------------------------------------------------------------
#  ⚠️  Le RP ID est le domaine, sans schéma ni port. Il est LIÉ au domaine :
#      le changer invalide TOUTES les passkeys déjà enrôlées, et chaque
#      collaborateur devra réenrôler son appareil avec un nouveau code.
#
#  Laissé vide, il est déduit de PUBLIC_URL — c'est le cas normal.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=CRM Cabinet
# Origine attendue. Laissée vide : PUBLIC_URL.
WEBAUTHN_ORIGIN=


# -----------------------------------------------------------------------------
#  5. Envoi de courrier (SMTP)
# -----------------------------------------------------------------------------
#  Chaque cabinet renseigne SON serveur d'envoi : aucun compte tiers à créer,
#  aucune vérification de domaine, aucun courrier qui transite par un
#  intermédiaire — les mails partent du domaine du cabinet, donc ils arrivent.
#
#  Ces valeurs sont le point de départ. L'application permet ensuite de les
#  modifier depuis Paramètres, sans accès SSH ; les réglages saisis là prennent
#  le pas sur ceux d'ici.
#
#  Exemple OVH :
#    SMTP_HOST=ssl0.ovh.net
#    SMTP_PORT=465
#    SMTP_SECURE=true
#
#  Port 587 : mettre SMTP_SECURE=false (STARTTLS, chiffrement négocié après la
#  connexion). Forcer true sur 587 fait échouer la connexion.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sans SMTP, l'application fonctionne : elle n'envoie simplement ni notification
# ni invitation, et les codes d'enrôlement s'affichent à l'écran.


# -----------------------------------------------------------------------------
#  6. INPI — registre national des entreprises (facultatif)
# -----------------------------------------------------------------------------
#  Identifiants du compte data.inpi.fr. Activent la récupération des fiches
#  d'entreprise et des actes juridiques.
#
#  Ils ne quittent jamais le serveur : c'est lui qui appelle l'INPI. Le
#  navigateur n'y a aucun accès.
INPI_USERNAME=
INPI_PASSWORD=


# -----------------------------------------------------------------------------
#  7. jedeclare — suivi des échéances (facultatif)
# -----------------------------------------------------------------------------
#  Identifiants du compte jedeclare.com du cabinet. Ils alimentent la page
#  « Suivi échéances » : les déclarations télétransmises, par type et par mois,
#  avec leur état d'avancement.
#
#  SEULS LE LOGIN ET LE MOT DE PASSE SONT NÉCESSAIRES. Sans eux, la page reste
#  accessible et annonce simplement qu'elle n'est pas configurée. Le CRM
#  n'impose aucun compte : c'est le cabinet qui fournit le sien.
#
#  ⚠️ LIRE UN ACCUSÉ LE MARQUE « RÉCUPÉRÉ » CHEZ JEDECLARE, et le logiciel de
#  production du cabinet peut alors ne plus le voir comme nouveau. Le CRM
#  n'analyse donc JAMAIS tout seul : aucune tâche planifiée, l'analyse est
#  déclenchée à la main par un administrateur, et seuls les accusés DÉJÀ marqués
#  récupérés sont lus (mode prudent, non débrayable). Avant la mise en service,
#  faites inscrire votre couple éditeur/logiciel sur la liste d'exclusion de
#  marquage auprès de contacts.editeurs@jedeclare.info.
JEDECLARE_LOGIN=
JEDECLARE_MDP=
#  ⚠️ `JEDECLARE_EDITEUR` N'EST PAS UN CODE À OBTENIR de jedeclare : c'est une
#  chaîne LIBRE par laquelle vous vous identifiez. Mettez-y le nom de votre
#  cabinet.
#
#  Elle a un défaut utilisable, mais elle compte : c'est le couple
#  ÉDITEUR / LOGICIEL que jedeclare inscrit sur sa liste d'exclusion de marquage.
#  Demandez l'exclusion pour le couple que vous déclarez ici.
JEDECLARE_EDITEUR=crmcabinet
JEDECLARE_LOGICIEL=crmcabinet
JEDECLARE_VERSION=1.0.0
# Numéro de compte, pour la lecture des dossiers clients. Facultatif.
JEDECLARE_ID_COMPTE=
#
#  PLUSIEURS COMPTES DE FLUX. Une requête jedeclare ne voit que le compte
#  qu'elle authentifie : il n'existe aucun paramètre pour en désigner un autre.
#  Un cabinet qui dépose ses flux sous deux comptes ne voyait donc que la moitié
#  de ses télétransmissions, sans que rien ne le signale — l'écran de suivi
#  paraissait simplement incomplet.
#
#  Déclarez les comptes suivants avec les suffixes `_2`, `_3`… Chacun est
#  interrogé séparément et les résultats sont fusionnés. Un compte à moitié
#  renseigné — login sans mot de passe — est ignoré. Un trou dans la
#  numérotation n'arrête pas la lecture : `_3` compte même si `_2` manque.
#
#  `JEDECLARE_EDITEUR`, `_LOGICIEL` et `_VERSION` restent communs : ils
#  identifient le logiciel appelant, pas le compte.
JEDECLARE_LOGIN_2=
JEDECLARE_MDP_2=
JEDECLARE_ID_COMPTE_2=


# -----------------------------------------------------------------------------
#  8. VIES — vérification des numéros de TVA intracommunautaire
# -----------------------------------------------------------------------------
#  ACTIF PAR DÉFAUT, et sans rien à configurer : le registre de la Commission
#  européenne est ouvert, sans clé ni compte. Un CRM qui refuserait de vérifier
#  un numéro de TVA faute de réglage serait cassé par défaut.
#
#  Qui est appelé, et quand : `ec.europa.eu` reçoit UN numéro de TVA, et
#  seulement quand un collaborateur clique sur « Vérifier » dans une fiche.
#
#  RIEN NE PART SANS CE CLIC. Aucune tâche planifiée, aucune vérification
#  nocturne, aucun traitement du portefeuille par lot — c'est ce qui rend tenable
#  la promesse « les seuls appels sortants sont ceux que vous configurez ».
#
#  VIES_DISABLED=1 coupe même cette possibilité : le numéro reste calculé depuis
#  le SIREN, il n'est simplement jamais confronté au registre.
VIES_DISABLED=0


# -----------------------------------------------------------------------------
#  9. Fichiers déposés
# -----------------------------------------------------------------------------
# Chemin du stockage. En Docker, un volume monté sur /app/data.
STORAGE_DIR=./data/storage
# Taille maximale d'un fichier, en octets. 10 Mo par défaut.
STORAGE_MAX_FILE_SIZE=10485760


# -----------------------------------------------------------------------------
#  10. Mises à jour
# -----------------------------------------------------------------------------
#  Seul flux sortant du produit en dehors des services configurés ci-dessus :
#  la lecture d'un fichier de version sur GitHub, pour signaler qu'une mise à
#  jour existe. Rien n'est envoyé, rien n'est appliqué automatiquement.
#
#  UPDATE_DISABLED=1 coupe même cette lecture.
UPDATE_DISABLED=0
# Version de l'image déployée. Permet un retour arrière par changement de tag.
VERSION=latest


# =============================================================================
#  Secrets Supabase : sans objet depuis la phase 3
# =============================================================================
#  VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#  SUPABASE_DB_URL, SUPABASE_DB_PASSWORD, ALLOWED_ORIGINS, RESEND_API_KEY,
#  RESEND_FROM_EMAIL : plus aucune référence dans le code.
#
#  ⚠️  La clé anon de l'ancien projet a figuré dans l'historique git (commit
#      initial, `test-send-email.sh`). Elle doit être considérée comme divulguée
#      et renouvelée avant que le dépôt ne devienne public. Voir MIGRATION.md §3.
