# ============================================================================
# CRM Cabinet — HTTPS automatique (Let's Encrypt).
#
# Domaine et adresse ACME injectés par docker-compose depuis le .env.
#
# Caddy ne relaie que vers `app`. PostgREST n'est PAS exposé ici : le front y
# accède par /rest/v1, que `app` relaie après contrôle de session. Ouvrir
# PostgREST directement contournerait ce contrôle.
# ============================================================================
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# En-têtes de sécurité. Ils étaient auparavant dans public/_headers, une
	# convention Netlify qui n'a aucun effet derrière Caddy — ils ne s'appliquaient
	# donc déjà plus.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"

		# Le serveur n'a pas à annoncer ce qu'il est.
		-Server
	}

	# L'ENCADREMENT : REFUSÉ PARTOUT, SAUF SUR LES FICHIERS DÉPOSÉS.
	# ------------------------------------------------------------------------
	# La fenêtre d'un bilan affiche la pièce survolée dans un `<iframe>` pointant
	# sur `/api/storage/...`, de MÊME ORIGINE. `X-Frame-Options: DENY` et
	# `frame-ancestors 'none'` interdisent pourtant TOUT encadrement — l'origine
	# identique n'y change rien, c'est la définition de `DENY` et de `'none'`. Le
	# navigateur affiche alors un rectangle blanc, sans message visible : l'aperçu
	# paraît cassé, et rien à l'écran ne dit pourquoi.
	#
	# Signalé en production le 2026-09-05, puis reproduit derrière un mandataire
	# qui rejoue ces deux en-têtes sur une instance locale :
	#
	#     sans eux    le fichier s'affiche dans le cadre
	#     avec eux    « Refused to frame ... because an ancestor violates the
	#                 following Content Security Policy directive », cadre vide
	#
	# ⚠️ POURQUOI DEUX SÉLECTEURS DISJOINTS, ET NON UNE SURCHARGE. Poser un second
	# `header` après le bloc global marcherait sans doute — la valeur écrite en
	# dernier gagne. « Sans doute » ne suffit pas pour une politique de sécurité
	# qu'on ne peut pas exercer ici : Caddy ne tourne pas dans le conteneur de
	# développement, et la CI n'en valide que la syntaxe. `not path` d'un côté,
	# `path` de l'autre : aucune réponse ne traverse les deux, et l'ordre des
	# directives ne décide de rien.
	#
	# ⚠️ SEULES CES DEUX-LÀ SONT SÉPARÉES. `nosniff`, HSTS, `Referrer-Policy` et
	# `Permissions-Policy` restent dans le bloc global, donc s'appliquent AUSSI
	# aux fichiers déposés — `nosniff` plus que tout autre, puisqu'il porte
	# précisément sur un contenu envoyé par un tiers.
	#
	# Ce qui reste protégé : l'application garde `DENY` et `'none'`. Les fichiers
	# déposés passent à `SAMEORIGIN` / `'self'` — encadrables par ce site, par
	# personne d'autre. Le reste de la politique est identique, `object-src 'none'`
	# et `script-src 'self'` compris.
	@fichiers path /api/storage/*
	@horsFichiers not path /api/storage/*

	header @horsFichiers {
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://geo.api.gouv.fr https://bodacc-datadila.opendatasoft.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	header @fichiers {
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://geo.api.gouv.fr https://bodacc-datadila.opendatasoft.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	# Les fichiers déposés peuvent atteindre 10 Mo ; la limite par défaut les
	# refuserait avant même d'atteindre l'application.
	request_body {
		max_size 20MB
	}

	# Les réponses de l'API ne doivent jamais être mises en cache par un
	# intermédiaire : elles dépendent de la session.
	@api path /api/* /rest/* /mcp*
	header @api Cache-Control "no-store"

	encode gzip zstd
	reverse_proxy app:3000

	log {
		output file /data/acces.log {
			roll_size 10MB
			roll_keep 5
		}
		# Les adresses IP sont des données personnelles : on ne les conserve pas
		# dans les journaux d'accès d'un outil interne, où elles n'apportent rien.
		#
		# ⚠️ L'URI PART AVEC, ET C'ÉTAIT LA PLUS GROSSE FUITE DES DEUX. Le front
		# interroge PostgREST par l'URL : filtres, tris et sélections y sont
		# écrits en clair. Ce journal contenait donc, ligne après ligne,
		# `?email=eq.jean.dupont@exemple.fr`, `?last_name=eq.DUPONT`, le nom des
		# pièces déposées — et la signature des URL de téléchargement, qui est
		# un secret d'accès. Supprimer les IP en laissant cela n'aurait protégé
		# personne.
		#
		# On SUPPRIME plutôt que d'assainir, contrairement au journal de
		# l'application, qui garde les noms de paramètres sans leurs valeurs
		# (`server/src/journal.ts`). Deux raisons : un filtre `regexp` qui ne
		# marche qu'à moitié laisse fuir sans le dire, et ce journal-ci fait
		# doublon — l'URL assainie, celle qui sert à diagnostiquer, est dans
		# celui de l'application. Il reste ici la méthode, le code de réponse,
		# la taille et la durée : de quoi voir une panne ou un flot anormal,
		# sans savoir de qui on parle.
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers delete
				request>uri delete
			}
		}
	}
}
